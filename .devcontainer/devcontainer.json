{
  "name": "GECAA",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[dev]' && (setsid nohup bash services/climada_worker/install.sh < /dev/null > /tmp/climada_install.log 2>&1 &)",
  "postAttachCommand": {
    "app": "uvicorn gecaa.api:app --host 0.0.0.0 --port 8000",
    "climada": "bash -c 'for i in $(seq 1 120); do [ -x $HOME/.venvs/gecaa-climada/bin/uvicorn ] && exec bash services/climada_worker/run.sh; sleep 10; done'"
  },
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "GECAA app",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}